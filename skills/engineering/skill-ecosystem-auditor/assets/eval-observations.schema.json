{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Activation Observations",
  "type": "object",
  "required": ["version", "evidence_class", "adapter", "host", "model", "isolated_skill", "runs"],
  "properties": {
    "version": { "type": "string" },
    "evidence_class": { "enum": ["FIXTURE", "RUNTIME-OBSERVED"] },
    "adapter": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "isolated_skill": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "baseline", "selected_skills", "activation_order"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "baseline": { "enum": ["full-ecosystem", "isolated-skill", "no-skill"] },
          "selected_skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "activation_order": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
