{
  "name": "mattpocock-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Matt Pocock's agent skills for real engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattpocock/skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "maintenance-risk:survey": "tsx scripts/repository-analysis/maintenance-risk-survey.ts",
    "test-suite-health:run": "tsx scripts/repository-analysis/test-suite-health-run.ts",
    "test-suite-health:survey": "tsx scripts/repository-analysis/test-suite-health-survey.ts",
    "test": "node --import tsx --test scripts/repository-analysis/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "packageManager": "npm@10.9.4"
}
