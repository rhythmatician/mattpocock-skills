{
  "name": "mattpocock-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Matt Pocock's agent skills for real engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattpocock/skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "feedback-loop-health:run": "node scripts/repository-analysis/run-node-with-userinfo-preflight.cjs node_modules/tsx/dist/cli.mjs scripts/repository-analysis/feedback-loop-health-run.ts",
    "feedback-loop-health:survey": "node scripts/repository-analysis/run-node-with-userinfo-preflight.cjs node_modules/tsx/dist/cli.mjs scripts/repository-analysis/feedback-loop-health-survey.ts",
    "maintenance-risk:survey": "node scripts/repository-analysis/run-node-with-userinfo-preflight.cjs node_modules/tsx/dist/cli.mjs scripts/repository-analysis/maintenance-risk-survey.ts",
    "skill-ecosystem:check": "tsx scripts/repository-analysis/skill-ecosystem-cli.ts integrity",
    "skill-ecosystem:evaluate": "tsx scripts/repository-analysis/skill-ecosystem-evaluation.ts",
    "skill-ecosystem:inventory": "tsx scripts/repository-analysis/skill-ecosystem-cli.ts inventory",
    "skill-ecosystem:references": "tsx scripts/repository-analysis/skill-ecosystem-cli.ts references",
    "skill-ecosystem:tokens": "tsx scripts/repository-analysis/skill-ecosystem-cli.ts tokens",
    "test-suite-health:run": "node scripts/repository-analysis/run-node-with-userinfo-preflight.cjs node_modules/tsx/dist/cli.mjs scripts/repository-analysis/test-suite-health-run.ts",
    "test-suite-health:survey": "node scripts/repository-analysis/run-node-with-userinfo-preflight.cjs node_modules/tsx/dist/cli.mjs scripts/repository-analysis/test-suite-health-survey.ts",
    "test": "node scripts/repository-analysis/run-node-with-userinfo-preflight.cjs --import tsx --test scripts/repository-analysis/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  },
  "packageManager": "npm@10.9.4"
}
